    <style>
        .table-wrap{
            border: 1px solid red;
            max-width: 1100px;
            margin: 40px auto;
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
        }


        table.minimal-table {
            width: 100% !important;
            margin: auto;
            border-collapse: collapse !important;
            font-size: 13px;
            color: #1f2937;
        }



        table.minimal-table thead {
            display: none;
        }
        table.minimal-table thead th {
            background: #f9fafb !important;
            color: #374151;
            font-weight: 600;
            border-bottom: 1px solid #e5e7eb !important;
            padding: 14px 16px !important;
        }

        table.minimal-table tbody td {
            /* padding: 14px 16px !important; */
            padding: 5px !important;
            border-bottom: 1px solid #f1f5f9 !important;
            vertical-align: middle;
        }
        table.minimal-table tbody a{
            text-decoration: none;
            color: black;
            cursor: pointer;    
            display: inline-flex;
            align-items: center; 
            gap: 5px;
        }
        table.minimal-table tbody a img{
            height: 16px;
        }
        table.minimal-table tbody tr:hover {
            background: #fafafa;
        }

        /* Linha de agrupamento */
        tr.dtrg-group th,
        tr.dtrg-group td {
            background: #ffffff !important;
            color: #111827;
            font-weight: 700;
            padding: 12px !important;
            border-top: 1px solid #e5e7eb !important;
            border-bottom: 1px solid #e5e7eb !important;
            text-align: center !important;
        }

        /* Remove detalhes visuais exagerados do DataTables */
        .dataTables_wrapper .dataTables_filter {
            padding: 16px;
            border-bottom: 1px solid #f3f4f6;
            background: #fff;
        }

        .dataTables_wrapper .dataTables_filter label {
            font-weight: 500;
            color: #4b5563;
        }

        .dataTables_wrapper .dataTables_filter input {
            margin-left: 8px;
            padding: 8px 12px;
            border: 1px solid #d1d5db;
            border-radius: 10px;
            outline: none;
            background: #fff;
        }

        .dataTables_wrapper .dataTables_filter input:focus {
            border-color: #9ca3af;
            box-shadow: 0 0 0 3px rgba(156, 163, 175, 0.15);
        }

        .dataTables_wrapper .dataTables_info,
        .dataTables_wrapper .dataTables_paginate,
        .dataTables_wrapper .dataTables_length {
            display: none !important;
        }

        table.dataTable.no-footer {
            border-bottom: none !important;
        }

        /* Linhas pares */
        table.minimal-table tbody tr:nth-child(even):not(.dtrg-group) {
            background: #f3f4f6; /* cinza claro */
        }

        /* Linhas ímpares */
        table.minimal-table tbody tr:nth-child(odd):not(.dtrg-group) {
            background: #e5e7eb; /* cinza um pouco mais escuro */
        }
    </style>
    </head>


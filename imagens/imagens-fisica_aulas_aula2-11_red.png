<style>
    .menu-tabela-wrap {
        width: 100%;
        display: flex;
        justify-content: center;
        margin: 24px 0 16px;
    }

    .menu-tabela {
        width: 100%;
        max-width: 1100px;
        display: flex;
        gap: 12px;
    }

    .menu-tabela-btn {
        flex: 1;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        border: 2px solid #004aab;
        background: #ffffff;
        color: #000000;
        font-size: 14px;
        font-weight: 600;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.2s ease;
        line-height: 1;
    }

    .menu-tabela-btn:hover {
        background: #004aab;
        color: #ffffff;
    }

    .menu-tabela-btn.ativo {
        background: #4bbd97;
        border-color: #4bbd97;
        color: #ffffff;
    }

    .menu-tabela-btn:active {
        transform: scale(0.97);
    }

    .menu-tabela-btn:focus {
        outline: none;
        box-shadow: 0 0 0 2px rgba(0, 74, 171, 0.2);
    }
</style>

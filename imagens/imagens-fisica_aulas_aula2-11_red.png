    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const btnLogin = document.getElementById('btnLogin');
            const btnPerfil = document.getElementById('btnPerfil');
            const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
            const usuario = null;

            if (btnPerfil && usuario) {
                btnPerfil.addEventListener('click', function() {
                    abrirModalPerfil();
                });

                btnPerfil.addEventListener('keydown', function(event) {
                    if (event.key === 'Enter' || event.key === ' ') {
                        event.preventDefault();
                        abrirModalPerfil();
                    }
                });
            }

            if (btnLogin) {
                btnLogin.addEventListener('click', function() {
                    abrirModalLogin();
                });
            }

            function abrirModalCarregamento(titulo, texto) {
                Swal.fire({
                    html: `
                        <div class="wf-loading-wrap">
                            <div class="wf-loader" aria-hidden="true">
                                <span class="wf-loader-ring ring-1"></span>
                                <span class="wf-loader-ring ring-2"></span>
                                <span class="wf-loader-ring ring-3"></span>
                                <span class="wf-loader-dot"></span>
                            </div>
                            <h3 class="wf-loading-title">${titulo}</h3>
                            <p class="wf-loading-text">${texto}</p>
                        </div>
                    `,
                    showConfirmButton: false,
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    background: '#ffffff',
                    width: 360,
                    customClass: {
                        popup: 'wf-loading-popup'
                    }
                });
            }

            function abrirModalSucesso(titulo, texto, corBotao = '#004aab') {
                Swal.fire({
                    html: `
                        <div class="wf-success-wrap">
                            <div class="wf-success-icon" aria-hidden="true">
                                <span class="wf-success-check"></span>
                            </div>
                            <h3 class="wf-success-title">${titulo}</h3>
                            <p class="wf-success-text">${texto}</p>
                        </div>
                    `,
                    confirmButtonText: 'OK',
                    background: '#ffffff',
                    width: 360,
                    customClass: {
                        popup: 'wf-success-popup',
                        confirmButton: 'wf-swal-confirm'
                    },
                    didOpen: () => {
                        const confirmButton = Swal.getConfirmButton();
                        if (confirmButton) {
                            confirmButton.style.backgroundColor = corBotao;
                        }
                    }
                });
            }

            function abrirModalErro(titulo, texto) {
                Swal.fire({
                    icon: 'error',
                    title: titulo,
                    text: texto,
                    confirmButtonText: 'OK',
                    background: '#ffffff',
                    color: '#000000',
                    width: 380,
                    customClass: {
                        popup: 'wf-swal-popup',
                        confirmButton: 'wf-swal-confirm'
                    }
                });
            }

            function abrirModalLogin() {
                Swal.fire({
                    title: 'Entrar',
                    html: `
                        <div class="wf-swal-wrap">
                            <input id="swal-email" class="swal2-input wf-input" type="email" placeholder="Seu e-mail">

                            <div class="wf-password-wrap">
                                <input id="swal-password" class="swal2-input wf-input wf-password-input" type="password" placeholder="Sua senha">
                                <button type="button" id="togglePassword" class="wf-toggle-password" aria-label="Mostrar ou ocultar senha">👁</button>
                            </div>

                            <div class="wf-forgot-wrap">
                                <a href="javascript:void(0)" id="forgotPasswordLink" class="wf-forgot-link">Esqueci minha senha</a>
                            </div>
                        </div>
                    `,
                    showCancelButton: true,
                    confirmButtonText: 'Entrar',
                    cancelButtonText: 'Cancelar',
                    focusConfirm: false,
                    background: '#ffffff',
                    color: '#000000',
                    width: 460,
                    customClass: {
                        popup: 'wf-swal-popup',
                        title: 'wf-swal-title',
                        confirmButton: 'wf-swal-confirm',
                        cancelButton: 'wf-swal-cancel'
                    },
                    didOpen: () => {
                        const passwordInput = document.getElementById('swal-password');
                        const togglePassword = document.getElementById('togglePassword');
                        const forgotPasswordLink = document.getElementById('forgotPasswordLink');

                        if (togglePassword && passwordInput) {
                            togglePassword.addEventListener('click', function() {
                                const isPassword = passwordInput.type === 'password';
                                passwordInput.type = isPassword ? 'text' : 'password';
                                togglePassword.textContent = isPassword ? '🙈' : '👁';
                            });
                        }

                        if (forgotPasswordLink) {
                            forgotPasswordLink.addEventListener('click', function() {
                                Swal.close();
                                abrirModalRedefinirSenha();
                            });
                        }
                    },
                    preConfirm: () => {
                        const email = document.getElementById('swal-email').value.trim();
                        const password = document.getElementById('swal-password').value.trim();

                        if (!email || !password) {
                            Swal.showValidationMessage('Preencha e-mail e senha.');
                            return false;
                        }

                        return {
                            email,
                            password
                        };
                    }
                }).then(async (result) => {
                    if (!result.isConfirmed) return;

                    const {
                        email,
                        password
                    } = result.value;

                    abrirModalCarregamento(
                        'Entrando...',
                        'Estamos validando suas credenciais.'
                    );

                    try {
                        const response = await fetch("https://webfisica.com/user-auth", {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json",
                                "X-CSRF-TOKEN": csrfToken,
                                "X-Requested-With": "XMLHttpRequest",
                                "Accept": "application/json"
                            },
                            body: JSON.stringify({
                                email,
                                password
                            })
                        });

                        const data = await response.json().catch(() => ({}));

                        if (!response.ok) {
                            if (response.status === 422 && data.errors) {
                                const primeiraMensagem =
                                    data.errors.email?.[0] ||
                                    data.errors.password?.[0] ||
                                    data.message ||
                                    'Dados inválidos.';
                                throw new Error(primeiraMensagem);
                            }

                            throw new Error(data.message || 'E-mail ou senha inválidos.');
                        }

                        await abrirModalSucesso(
                            'Login realizado',
                            data.message || 'Você será redirecionado.',
                            '#4bbd97'
                        );

                        window.location.href = data.redirect || "https://webfisica.com";
                    } catch (error) {
                        abrirModalErro(
                            'Erro no login',
                            error.message || 'Não foi possível entrar.'
                        );
                    }
                });
            }

            function abrirModalRedefinirSenha() {
                Swal.fire({
                    title: 'Redefinir senha',
                    html: `
                        <div class="wf-swal-wrap">
                            <input id="reset-email" class="swal2-input wf-input" type="email" placeholder="Digite seu e-mail">
                        </div>
                    `,
                    showCancelButton: true,
                    confirmButtonText: 'Enviar link',
                    cancelButtonText: 'Voltar',
                    background: '#ffffff',
                    color: '#000000',
                    width: 430,
                    customClass: {
                        popup: 'wf-swal-popup',
                        title: 'wf-swal-title',
                        confirmButton: 'wf-swal-confirm',
                        cancelButton: 'wf-swal-cancel'
                    },
                    preConfirm: () => {
                        const email = document.getElementById('reset-email').value.trim();

                        if (!email) {
                            Swal.showValidationMessage('Digite seu e-mail.');
                            return false;
                        }

                        return {
                            email
                        };
                    }
                }).then(async (result) => {
                    if (result.dismiss === Swal.DismissReason.cancel) {
                        abrirModalLogin();
                        return;
                    }

                    if (!result.isConfirmed) {
                        return;
                    }

                    const {
                        email
                    } = result.value;

                    abrirModalCarregamento(
                        'Enviando link...',
                        'Estamos preparando a redefinição da sua senha.'
                    );

                    try {
                        const response = await fetch(
                            "https://webfisica.com/primeiro-acesso-recuperar-senha", {
                                method: "POST",
                                headers: {
                                    "Content-Type": "application/json",
                                    "X-CSRF-TOKEN": csrfToken,
                                    "Accept": "application/json"
                                },
                                body: JSON.stringify({
                                    email: email
                                })
                            });

                        const data = await response.json().catch(() => ({}));

                        if (!response.ok) {
                            throw new Error(data.message ||
                                'Não foi possível enviar o link de redefinição.');
                        }

                        abrirModalSucesso(
                            'Link enviado',
                            data.message ||
                            `Se o e-mail ${email} existir, você receberá o link de redefinição.`,
                            '#4bbd97'
                        );
                    } catch (error) {
                        abrirModalErro(
                            'Erro ao enviar',
                            error.message || 'Ocorreu um erro ao tentar enviar o link.'
                        );
                    }
                });
            }

            function abrirModalPerfil() {
                Swal.fire({
                    html: `
                        <div class="wf-profile-wrap">
                            <div class="wf-profile-header">
                                <div class="wf-profile-avatar">${usuario.inicial}</div>
                                <div>
                                    <h3 class="wf-profile-name">${usuario.name}</h3>
                                    <p class="wf-profile-email">${usuario.email}</p>
                                </div>
                            </div>

                            <div class="wf-profile-info">
                                <div class="wf-profile-card">
                                    <span class="wf-profile-label">Nome</span>
                                    <div class="wf-profile-value">${usuario.name}</div>
                                </div>

                                <div class="wf-profile-card">
                                    <span class="wf-profile-label">E-mail</span>
                                    <div class="wf-profile-value">${usuario.email}</div>
                                </div>
                            </div>
                            <a href="https://webfisica.com/meu-perfil" class="wf-profile-config" id="btnConfig">
                                Configurações
                            </a> 
                            <br>
                            <a href="#" class="wf-profile-logout" id="btnLogout">
                                Sair da conta
                            </a>
                        </div>
                    `,
                    showConfirmButton: false,
                    showCloseButton: true,
                    background: '#ffffff',
                    color: '#000000',
                    width: 430,
                    customClass: {
                        popup: 'wf-swal-popup',
                        title: 'wf-swal-title'
                    },
                    didOpen: () => {
                        const btnLogout = document.getElementById('btnLogout');

                        if (btnLogout) {
                            btnLogout.addEventListener('click', async function(event) {
                                event.preventDefault();

                                abrirModalCarregamento(
                                    'Saindo...',
                                    'Encerrando sua sessão com segurança.'
                                );

                                try {
                                    const response = await fetch(usuario.logoutUrl, {
                                        method: 'POST',
                                        headers: {
                                            'X-CSRF-TOKEN': csrfToken,
                                            'X-Requested-With': 'XMLHttpRequest',
                                            'Accept': 'application/json'
                                        }
                                    });

                                    const data = await response.json().catch(() => ({}));

                                    if (!response.ok) {
                                        throw new Error(data.message ||
                                            `Erro HTTP ${response.status}`);
                                    }

                                    window.location.href = data.redirect || '/';
                                } catch (error) {
                                    abrirModalErro(
                                        'Erro ao sair',
                                        error.message ||
                                        'Ocorreu um erro ao encerrar a sessão.'
                                    );
                                }
                            });
                        }
                    }
                });
            }
        });
    </script>

        <script>
        $(document).ready(function () {
            $('#tabela-aulas').DataTable({
                paging: false,
                info: false,
                searching: true,
                ordering: true,
                order: [],
                columnDefs: [
                    { targets: 0, visible: false } 
                ],
                rowGroup: {
                    dataSrc: 0
                },
                language: {
                    search: "Buscar:",
                    zeroRecords: "Nenhum resultado encontrado",
                    emptyTable: "Nenhum dado disponível na tabela"
                }
            });
        });
    </script>
</body>

